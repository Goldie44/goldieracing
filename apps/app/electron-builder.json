{
  "appId": "com.f1manager.app",
  "productName": "Manager Companion",
  "directories": {
    "output": "release"
  },
  "files": ["dist/**/*", "build/icon.png", "package.json"],
  "extraResources": [
    {
      "from": "../web/dist",
      "to": "web"
    }
  ],
  "npmRebuild": false,
  "mac": {
    "category": "public.app-category.sports",
    "target": ["dmg", "zip"]
  },
  "win": {
    "target": ["nsis"],
    "icon": "build/icon.ico"
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "build/icon.png"
  }
}
